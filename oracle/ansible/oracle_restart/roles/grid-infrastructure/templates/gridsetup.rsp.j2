# =============================================================================
# Grid Infrastructure response file — generated by Ansible
# Keys match the 19.0 response-file XSD schema exactly
# =============================================================================
oracle.install.responseFileVersion=/oracle/install/rspfmt_crsinstall_response_schema_v19.0.0
INVENTORY_LOCATION={{ inventory_loc }}
oracle.install.option=HA_CONFIG
ORACLE_BASE={{ grid_base }}
oracle.install.asm.OSDBA=asmdba
oracle.install.asm.OSOPER=asmoper
oracle.install.asm.OSASM={{ asm_admin_group }}
oracle.install.asm.configureGIMRDataDG=false
oracle.install.asm.SYSASMPassword={{ asm_sys_password }}
oracle.install.asm.diskGroup.name=OCR
oracle.install.asm.diskGroup.redundancy=EXTERNAL
oracle.install.asm.diskGroup.AUSize={{ asm_diskgroup_au_size }}
oracle.install.asm.diskGroup.disks=/dev/oracleasm/asm-ocr
oracle.install.asm.diskGroup.diskDiscoveryString=/dev/oracleasm/*
oracle.install.asm.monitorPassword={{ asm_monitor_password }}
