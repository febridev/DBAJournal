# Oracle ASM disk rules - generated by Ansible (Phase 2)
{% for r in asm_rules %}
# {{ r.role | upper }} ({{ '/dev/' + r.dev }}) serial={{ r.serial }}
KERNEL=="sd*", ENV{ID_SCSI_SERIAL}=="{{ r.serial }}", SYMLINK+="oracleasm/asm-{{ r.role }}", OWNER="{{ asm_user }}", GROUP="{{ asm_admin_group }}", MODE="0660"
{% endfor %}
